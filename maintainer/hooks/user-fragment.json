{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "AI_SDLC_HOME='{home}' /bin/sh '{repo}/maintainer/hooks/block-env-dump.sh'" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "AI_SDLC_HOME='{home}' /usr/bin/python3 '{repo}/maintainer/hooks/wrap-bash-exit-code.py'" }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "AI_SDLC_HOME='{home}' /bin/sh '{repo}/maintainer/hooks/require-guardrails.sh'" }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          { "type": "command", "command": "AI_SDLC_HOME='{home}' TL_RELAY_LESSONS='{home}/lessons' /bin/sh '{repo}/hooks/inject-lesson.sh'" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "AI_SDLC_HOME='{home}' TL_RELAY_LESSONS='{home}/lessons' /bin/sh '{repo}/hooks/inject-lesson.sh'" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "AI_SDLC_HOME='{home}' /usr/bin/python3 '{repo}/maintainer/hooks/redact-secrets-output.py'" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          { "type": "command", "command": "AI_SDLC_HOME='{home}' /bin/sh '{repo}/hooks/session-start-skills.sh'" }
        ]
      }
    ]
  }
}
